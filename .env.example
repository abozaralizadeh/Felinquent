# Copy to .env if you need to change a default. No real secrets belong in this repo.
# Local Ollama server used by the optional LLM brain.
FELINQUENT_OLLAMA_URL=http://localhost:11434
FELINQUENT_OLLAMA_MODEL=gemma3:1b
# Where the size-limited logs go (default: ./logs in dev).
FELINQUENT_LOG_DIR=./logs
# Port for the playground service (setup_service.sh).
FELINQUENT_PORT=4173
# Cloud LLM keys are deliberately not supported. The brain is local or fake.
