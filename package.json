{
  "name": "felinquent",
  "version": "0.1.16",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "description": "A cat that lives on your desktop and does whatever it wants.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:app": "npm run build && node -e \"require('fs').rmSync('dist/sprites', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:forbidden": "tsx tools/check-forbidden-apis.ts",
    "eval": "tsx tools/brain-eval/run.ts",
    "pace": "tsx tools/pace.ts",
    "month": "tsx tools/month.ts",
    "serve": "vite preview --host 0.0.0.0 --port 4173",
    "tauri": "tauri",
    "bundle:mac": "tauri build --bundles app",
    "bundle:win": "tauri build --bundles nsis",
    "probe": "cd src-tauri && cargo run --release --bin probe",
    "bundle:mac-dmg": "tauri build --bundles app,dmg",
    "bundle:mac-universal": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "install:mac": "bash scripts/install-mac.sh",
    "uninstall:mac": "bash scripts/uninstall-mac.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
