{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Felinquent",
  "version": "0.0.1",
  "identifier": "app.felinquent.spike",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Felinquent overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "resizable": false,
        "x": 0,
        "y": 0,
        "width": 1440,
        "height": 900
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Entertainment",
    "shortDescription": "A desktop pet that does whatever it wants.",
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
